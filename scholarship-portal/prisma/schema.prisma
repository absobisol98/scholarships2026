// Scholarship Portal — data model.
// Postgres via Prisma. status/kind fields are plain strings (not native enums) with
// allowed values enforced in code — carried over from this schema's SQLite origins,
// where enums weren't supported; kept as-is on Postgres to avoid a separate refactor.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// A scholarship program (U-GO, Generika, EO Skolar, ...).
model Program {
  id            Int      @id @default(autoincrement())
  key           String   @unique
  name          String
  amount        String
  deadlineLabel String
  deadlineFull  String
  blurb         String
  tagsJson      String // JSON string array
  formKind      String // "standard" | "generika" (swaps academic step for leadership step)
  photoUrl      String?
  order         Int      @default(0)
  active        Boolean  @default(true)
  // Admin-uploaded blank recommendation-form template (Storage path), downloaded by
  // shortlisted applicants during Paper Screening and re-uploaded completed — see
  // Application.recommendationFileName below.
  recommendationTemplatePath String?

  cohorts      Cohort[]
  applications Application[]
  fieldConfigs FieldConfig[]
  gradeCheckPeriods GradeCheckPeriod[]
  staffAssignments StaffProgramAssignment[]
  auditLogEntries  AuditLogEntry[]
  screenerGroups   ScreenerGroup[]
}

// An application cycle/batch for a program. Only one is "active" at a time.
model Cohort {
  id                  String   @id @default(cuid())
  programId           Int
  program             Program  @relation(fields: [programId], references: [id])
  name                String
  status              String   @default("inactive") // "active" | "inactive" | "closed"
  openDate            String   @default("Not set")
  cutoffDate          String   @default("Not set")
  autoSubmitPolicy    String   @default("leave_incomplete") // "auto_submit" | "leave_incomplete"
  signupsOpen         Boolean  @default(true)
  loginsOpen          Boolean  @default(true)
  oldAccountsCanLogin Boolean  @default(true)
  createdAt           DateTime @default(now())

  criteria     Criterion[]
  history      CriteriaHistoryEntry[]
  applications Application[]

  @@index([programId])
}

// One hard-filter criterion belonging to a cohort.
model Criterion {
  id       String  @id @default(cuid())
  cohortId String
  cohort   Cohort  @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  key      String // "nat" | "sex" | "year" | "inst" | "gwa"
  label    String
  type     String // "equals" | "gte"
  value    String
  enabled  Boolean @default(true)
  order    Int     @default(0)

  @@index([cohortId])
}

// Versioned log of criteria/window edits, so past evaluations aren't silently reinterpreted.
model CriteriaHistoryEntry {
  id        String   @id @default(cuid())
  cohortId  String
  cohort    Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  date      String
  summary   String
  createdAt DateTime @default(now())

  @@index([cohortId])
}

// The single demo applicant persona ("Amara Chen") — the account behind "Log in as applicant".
model Student {
  id        Int      @id @default(autoincrement())
  name      String
  initials  String
  email     String   @unique
  createdAt DateTime @default(now())
  // Embedded in the signed session cookie at login; bumped on logout. A cookie whose
  // embedded version no longer matches this column is treated as revoked even though its
  // signature is still valid — the app's only real session-revocation mechanism, since
  // there's no separate server-side session store to delete from.
  sessionVersion Int @default(0)

  applications Application[]
}

// A student's application to one program. Independent progress/state per program.
model Application {
  id            Int      @id @default(autoincrement())
  studentId     Int
  student       Student  @relation(fields: [studentId], references: [id])
  programId     Int
  program       Program  @relation(fields: [programId], references: [id])
  cohortId      String?
  cohort        Cohort?  @relation(fields: [cohortId], references: [id])
  status        String   @default("not_started") // "not_started" | "in_progress" | "submitted" | "awarded" | "declined"
  formStep      Int      @default(0)
  submittedDate String?
  awardDate     String?
  awardResponse String? // "accepted" | "declined" | null

  // Personal
  fullName String @default("")
  dob      String @default("")
  email    String @default("")
  phone    String @default("")
  address  String @default("")

  // Location, for demographic reporting (region/province/city/municipality breakdowns) —
  // region is a fixed dropdown, the rest free text (see src/lib/program-defaults.ts).
  region       String @default("")
  province     String @default("")
  city         String @default("")
  municipality String @default("")

  // Eligibility-relevant demographic fields — checked against the active Cohort's
  // Criterion rows (see evaluateCriteria in src/lib/admin-data.ts) right after the
  // Personal step is saved, so an ineligible applicant is stopped early rather than at
  // final submission.
  nationality     String @default("")
  sex             String @default("")
  yearLevel       String @default("")
  institutionType String @default("")

  // Automated duplicate-applicant screening (see src/lib/duplicate-check.ts) — set when a
  // fuzzy (not exact) name+DOB match against another Application in the same program is
  // found. An exact match is blocked outright rather than flagged.
  duplicateFlag       Boolean @default(false)
  duplicateFlagReason String?

  // Family
  guardianName String @default("")
  guardianOcc  String @default("")
  income       String @default("")
  dependents   String @default("")

  // Academic (standard programs)
  school      String @default("")
  gpa         String @default("")
  graduation  String @default("")
  major       String @default("")
  certFileName  String?
  videoFileName String?

  // Shortlisted applicants (anyone in the Paper Screening phase — see PAPER_SCREENING_PHASE_INDEX
  // in src/lib/steps.ts) download the program's recommendation-form template and re-upload
  // it completed here. promoteApplicant (src/lib/actions/admin.ts) requires this to be set
  // before advancing an applicant out of Paper Screening into Interviews. Not the same thing
  // as the Recommendation model below (a screener's own recommend/not-recommend verdict).
  recommendationFileName String?

  // Leadership (Generika-style programs)
  leadRole     String @default("")
  leadOrg      String @default("")
  leadDuration String @default("")
  leadPeople   String @default("")
  leadDesc     String @default("")

  // Community
  volunteerOrg    String @default("")
  volunteerHours  String @default("")
  volunteerYears  String @default("")
  communityDesc   String @default("")

  // Personal statement
  essayText  String @default("")
  essayText2 String @default("")

  // Answers to admin-added custom FieldConfig rows (fieldKey: null) — a JSON object
  // keyed by FieldConfig.id, e.g. {"clxyz...": "some answer"}. The known default fields
  // above keep their own typed columns; only genuinely custom fields land here.
  customFieldsJson String @default("{}")

  // Checklist completion, tracked per-application
  personalDone   Boolean @default(false)
  familyDone     Boolean @default(false)
  academicsDone  Boolean @default(false)
  communityDone  Boolean @default(false)
  essaysDone     Boolean @default(false)

  // Admin-side review state — merged in from the formerly-separate, disconnected
  // Applicant model (see git history: "unify Applicant into Application"). phaseIndex
  // tracks progress through APPLICANT_PHASES (src/lib/steps.ts); decision is the Super
  // Admin's final call, independent of the applicant-facing `status` above (a
  // "waitlisted" decision, for instance, leaves status at "submitted" since there's no
  // applicant-facing waitlist state yet).
  phaseIndex Int     @default(0)
  decision   String? // "awarded" | "waitlisted" | "declined" | null

  // Super Admin exception handling: a flagged application can be manually cleared without
  // deleting the underlying flags — the reasons stay visible, just marked resolved.
  flagOverridden     Boolean   @default(false)
  flagOverrideReason String?
  flagOverriddenBy   String?
  flagOverriddenAt   DateTime?

  // Counts failed eligibility-check attempts on the Personal/Academic steps (see
  // checkDuplicateAndEligibility/checkGwaEligibility in src/lib/actions/student.ts) — caps
  // how many times someone can try different answers to find a combination that passes,
  // rather than letting them retry indefinitely. Admin-resettable (resetIneligibleAttempts).
  ineligibleAttempts Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  familyMembers       FamilyMember[]
  screenerAssignments ScreenerAssignment[]
  rubricScores        RubricScore[]
  recommendations     Recommendation[]
  gradeCheckSubmissions GradeCheckSubmission[]

  // Includes cohortId (not just studentId+programId) so a scholar can have a separate
  // Application per renewal cycle — see getApplication/resolveApplicationForDisplay/
  // resolveApplicationForAward in src/lib/student-data.ts for how the right one is picked.
  @@unique([studentId, programId, cohortId])
  @@index([programId, status])
  @@index([programId, dob])
  @@index([programId, decision])
}

// Repeatable family-member rows (Generika's "add as many as relevant").
model FamilyMember {
  id            Int         @id @default(autoincrement())
  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name          String      @default("")
  relationship  String      @default("")
  occupation    String      @default("")
  order         Int         @default(0)

  @@index([applicationId])
}

// A staff account: a Program Admin (scoped to one or more programs) or a Paper Screener
// (scoped to individually-assigned applicants). Demo login still has no real credentials —
// this models real scope/roster data (what Manage Users administers) without requiring one.
model StaffAccount {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique // the real login identifier — see loginWithEmail
  role      String // "admin" | "screener" | "super_admin"
  active    Boolean  @default(true)
  isDemo    Boolean  @default(false) // the one account "Log in as ..." actually assumes, per role
  createdAt DateTime @default(now())

  company              String? // bulk-import roster field, mainly populated for screeners
  // Real password auth — scoped to screener accounts only. A null passwordHash means this
  // account still logs in by email alone (every other role, and any screener created before
  // this feature or never given a password), matching loginWithEmail's existing behavior.
  passwordHash         String?
  inviteToken          String?   @unique // opaque, single-use magic-link token to nominate a password
  inviteTokenExpiresAt DateTime?
  privacyAcceptedAt    DateTime? // set once a screener clicks "Proceed" on the first-login PH Data Privacy Act modal
  // Same mechanism as Student.sessionVersion — see that field's comment. Also bumped when
  // this account is deactivated, so an already-issued cookie stops working immediately
  // rather than staying valid for the rest of its 7-day lifetime.
  sessionVersion       Int       @default(0)

  programAssignments   StaffProgramAssignment[]
  screenerAssignments  ScreenerAssignment[]
  rubricScores         RubricScore[]
  recommendations      Recommendation[]
  groupMemberships     ScreenerGroupMember[]
}

// A named team of Paper Screeners within a program (e.g. "U-GO Screening Panel"), used to
// randomly distribute eligible, unassigned applicants across its members in one action.
model ScreenerGroup {
  id        String   @id @default(cuid())
  programId Int
  program   Program  @relation(fields: [programId], references: [id])
  name      String
  createdAt DateTime @default(now())

  members ScreenerGroupMember[]

  @@index([programId])
}

model ScreenerGroupMember {
  id      String        @id @default(cuid())
  groupId String
  group   ScreenerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  staffId String
  staff   StaffAccount  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([groupId, staffId])
}

// Which program(s) a Program Admin manages. (Paper Screeners are scoped by applicant
// assignment instead — see ApplicantAssignment.)
model StaffProgramAssignment {
  id        String  @id @default(cuid())
  staffId   String
  staff     StaffAccount @relation(fields: [staffId], references: [id], onDelete: Cascade)
  programId Int
  program   Program @relation(fields: [programId], references: [id])

  @@unique([staffId, programId])
}

// Which applications a Paper Screener has been assigned to review, set by an Admin.
model ScreenerAssignment {
  id            String      @id @default(cuid())
  applicationId Int
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  screenerId    String
  screener      StaffAccount @relation(fields: [screenerId], references: [id], onDelete: Cascade)
  assignedAt    DateTime     @default(now())

  @@unique([applicationId, screenerId])
  @@index([screenerId])
}

// A Paper Screener's 1-5 score on one soft (human-judged) criterion for one application.
model RubricScore {
  id            String       @id @default(cuid())
  applicationId Int
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  screenerId    String
  screener      StaffAccount @relation(fields: [screenerId], references: [id], onDelete: Cascade)
  criterionKey  String // "financial_hardship" | "leadership" | "essay_quality"
  score         Int
  updatedAt     DateTime @updatedAt

  @@unique([applicationId, screenerId, criterionKey])
}

// A Paper Screener's overall recommend / not-recommend call on an application, with comments.
model Recommendation {
  id            String       @id @default(cuid())
  applicationId Int
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  screenerId    String
  screener      StaffAccount @relation(fields: [screenerId], references: [id], onDelete: Cascade)
  decision      String // "recommend" | "not_recommend"
  comment       String   @default("")
  updatedAt     DateTime @updatedAt

  @@unique([applicationId, screenerId])
}

// System/program activity log — user management, red-flag overrides, award decisions.
model AuditLogEntry {
  id        String   @id @default(cuid())
  programId Int? // null = system-wide (not tied to one program)
  program   Program? @relation(fields: [programId], references: [id])
  actor     String // display name of who did it
  action    String
  createdAt DateTime @default(now())

  @@index([programId])
  @@index([createdAt])
}

// Per-program, per-step application field configuration (mockup — governs the "Manage fields" screen).
model FieldConfig {
  id          String  @id @default(cuid())
  programId   Int
  program     Program @relation(fields: [programId], references: [id])
  step        String // "personal" | "family" | "academic" | "leadership" | "community" | "statement"
  label       String
  required    Boolean @default(false)
  enabled     Boolean @default(true)
  order       Int     @default(0)
  fieldType   String  @default("text") // "text" | "paragraph" | "dropdown" | "number" — the applicant-facing input type
  optionsJson String  @default("[]") // dropdown choices, or quick-pick suggestions for the other types: JSON string array

  // Ties this row to a specific Application scalar column (e.g. "fullName", "dob") or to
  // one of the special widget sentinels ("cert" | "video" | "essayText" |
  // "familyMembers") — null means this is an admin-added custom field, whose answers live
  // in Application.customFieldsJson instead of a dedicated column.
  fieldKey String?

  @@index([programId, step])
}

// An admin-opened post-award grade-check period for a program (e.g. "Q1 2027" or "January
// 2027") — admin-typed label, not a fixed enum, since periods recur indefinitely across a
// scholar's multi-year renewal at whatever monthly/quarterly cadence the program runs on
// (this app has no scheduler/cron infra, so periods open manually, one at a time).
model GradeCheckPeriod {
  id        String @id @default(cuid())
  programId Int
  program   Program @relation(fields: [programId], references: [id])
  label     String
  dueDate   String?
  status    String  @default("draft") // "draft" | "deployed"
  createdAt DateTime @default(now())

  submissions GradeCheckSubmission[]

  @@unique([programId, label])
}

// Records that a grade-check period was sent to a given awarded application, and (once
// submitted) the applicant's uploaded certificate of grades + self-reported GWA, plus the
// admin's review outcome. One row per (applicationId, periodId) — a resubmission (over a
// previously-reviewed row) resets reviewStatus back to "pending" since new information needs
// re-review; see submitGradeCheck in src/lib/actions/student.ts.
model GradeCheckSubmission {
  id            Int      @id @default(autoincrement())
  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id])
  periodId      String
  period        GradeCheckPeriod @relation(fields: [periodId], references: [id])
  sentDate      String
  gwaFileName   String?
  reportedGwa   String?
  submittedAt   DateTime?
  reviewStatus  String  @default("pending") // "pending" | "compliant" | "probation" | "revoked"
  reviewNote    String?
  reviewedBy    String?
  reviewedAt    DateTime?

  @@unique([applicationId, periodId])
}

// Self-contained, Postgres-backed rate limiting (no external service) — one row per
// attempt against a given key (e.g. "signup:someone@example.com"). checkRateLimit()
// (src/lib/rate-limit.ts) counts recent rows for a key within its window and opportunistically
// prunes that key's rows once they age out, so this table stays bounded without a cron job.
model RateLimitAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
