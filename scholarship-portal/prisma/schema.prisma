// Scholarship Portal — data model.
// Postgres via Prisma. status/kind fields are plain strings (not native enums) with
// allowed values enforced in code — carried over from this schema's SQLite origins,
// where enums weren't supported; kept as-is on Postgres to avoid a separate refactor.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// A scholarship program (U-GO, Generika, EO Skolar, ...).
model Program {
  id            Int      @id @default(autoincrement())
  key           String   @unique
  name          String
  amount        String
  deadlineLabel String
  deadlineFull  String
  blurb         String
  tagsJson      String // JSON string array
  formKind      String // "standard" | "generika" (swaps academic step for leadership step)
  photoUrl      String?
  order         Int      @default(0)

  cohorts      Cohort[]
  applications Application[]
  applicants   Applicant[]
  fieldConfigs FieldConfig[]
  surveyWaves  SurveyWave[]
  staffAssignments StaffProgramAssignment[]
  auditLogEntries  AuditLogEntry[]
  screenerGroups   ScreenerGroup[]
}

// An application cycle/batch for a program. Only one is "active" at a time.
model Cohort {
  id                  String   @id @default(cuid())
  programId           Int
  program             Program  @relation(fields: [programId], references: [id])
  name                String
  status              String   @default("inactive") // "active" | "inactive" | "closed"
  openDate            String   @default("Not set")
  cutoffDate          String   @default("Not set")
  autoSubmitPolicy    String   @default("leave_incomplete") // "auto_submit" | "leave_incomplete"
  signupsOpen         Boolean  @default(true)
  loginsOpen          Boolean  @default(true)
  oldAccountsCanLogin Boolean  @default(true)
  createdAt           DateTime @default(now())

  criteria     Criterion[]
  history      CriteriaHistoryEntry[]
  applications Application[]

  @@index([programId])
}

// One hard-filter criterion belonging to a cohort.
model Criterion {
  id       String  @id @default(cuid())
  cohortId String
  cohort   Cohort  @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  key      String // "nat" | "sex" | "year" | "inst" | "gwa"
  label    String
  type     String // "equals" | "gte"
  value    String
  enabled  Boolean @default(true)
  order    Int     @default(0)

  @@index([cohortId])
}

// Versioned log of criteria/window edits, so past evaluations aren't silently reinterpreted.
model CriteriaHistoryEntry {
  id        String   @id @default(cuid())
  cohortId  String
  cohort    Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  date      String
  summary   String
  createdAt DateTime @default(now())

  @@index([cohortId])
}

// The single demo applicant persona ("Amara Chen") — the account behind "Log in as applicant".
model Student {
  id        Int      @id @default(autoincrement())
  name      String
  initials  String
  email     String   @unique
  createdAt DateTime @default(now())

  applications Application[]
}

// A student's application to one program. Independent progress/state per program.
model Application {
  id            Int      @id @default(autoincrement())
  studentId     Int
  student       Student  @relation(fields: [studentId], references: [id])
  programId     Int
  program       Program  @relation(fields: [programId], references: [id])
  cohortId      String?
  cohort        Cohort?  @relation(fields: [cohortId], references: [id])
  status        String   @default("not_started") // "not_started" | "in_progress" | "submitted" | "awarded" | "declined"
  formStep      Int      @default(0)
  submittedDate String?
  awardDate     String?
  awardResponse String? // "accepted" | "declined" | null

  // Personal
  fullName String @default("")
  dob      String @default("")
  email    String @default("")
  phone    String @default("")
  address  String @default("")

  // Family
  guardianName String @default("")
  guardianOcc  String @default("")
  income       String @default("")
  dependents   String @default("")

  // Academic (standard programs)
  school      String @default("")
  gpa         String @default("")
  graduation  String @default("")
  major       String @default("")
  certFileName  String?
  videoFileName String?

  // Leadership (Generika-style programs)
  leadRole     String @default("")
  leadOrg      String @default("")
  leadDuration String @default("")
  leadPeople   String @default("")
  leadDesc     String @default("")

  // Community
  volunteerOrg    String @default("")
  volunteerHours  String @default("")
  volunteerYears  String @default("")
  communityDesc   String @default("")

  // Personal statement
  essayText  String @default("")
  essayText2 String @default("")

  // Answers to admin-added custom FieldConfig rows (fieldKey: null) — a JSON object
  // keyed by FieldConfig.id, e.g. {"clxyz...": "some answer"}. The known default fields
  // above keep their own typed columns; only genuinely custom fields land here.
  customFieldsJson String @default("{}")

  // Checklist completion, tracked per-application
  personalDone   Boolean @default(false)
  familyDone     Boolean @default(false)
  academicsDone  Boolean @default(false)
  communityDone  Boolean @default(false)
  essaysDone     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  familyMembers FamilyMember[]

  @@unique([studentId, programId])
  @@index([programId, status])
}

// Repeatable family-member rows (Generika's "add as many as relevant").
model FamilyMember {
  id            Int         @id @default(autoincrement())
  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name          String      @default("")
  relationship  String      @default("")
  occupation    String      @default("")
  order         Int         @default(0)

  @@index([applicationId])
}

// Admin-side queue of applicants (distinct from the demo student's own applications) —
// the working list program admins review, promote/demote, and evaluate against cohort criteria.
model Applicant {
  id              Int      @id @default(autoincrement())
  programId       Int
  program         Program  @relation(fields: [programId], references: [id])
  name            String
  school          String
  gpa             String
  submitted       String
  status          String   @default("review") // "review" | "decided"
  decision        String? // "awarded" | "waitlisted" | "declined" | null
  nationality     String
  sex             String
  yearLevel       String
  institutionType String
  gwa             Int
  phaseIndex      Int      @default(0)
  essay           String   @default("")
  attachmentsJson String   @default("[]")

  // Super Admin exception handling: a flagged applicant can be manually cleared without
  // deleting the underlying flags — the reasons stay visible, just marked resolved.
  flagOverridden     Boolean   @default(false)
  flagOverrideReason String?
  flagOverriddenBy   String?
  flagOverriddenAt   DateTime?

  surveySends SurveySend[]
  screenerAssignments ApplicantAssignment[]
  rubricScores        RubricScore[]
  recommendations     Recommendation[]

  @@index([programId])
  @@index([programId, status])
}

// A staff account: a Program Admin (scoped to one or more programs) or a Paper Screener
// (scoped to individually-assigned applicants). Demo login still has no real credentials —
// this models real scope/roster data (what Manage Users administers) without requiring one.
model StaffAccount {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique // the real login identifier — see loginWithEmail
  role      String // "admin" | "screener" | "super_admin"
  active    Boolean  @default(true)
  isDemo    Boolean  @default(false) // the one account "Log in as ..." actually assumes, per role
  createdAt DateTime @default(now())

  programAssignments   StaffProgramAssignment[]
  applicantAssignments ApplicantAssignment[]
  rubricScores         RubricScore[]
  recommendations      Recommendation[]
  groupMemberships     ScreenerGroupMember[]
}

// A named team of Paper Screeners within a program (e.g. "U-GO Screening Panel"), used to
// randomly distribute eligible, unassigned applicants across its members in one action.
model ScreenerGroup {
  id        String   @id @default(cuid())
  programId Int
  program   Program  @relation(fields: [programId], references: [id])
  name      String
  createdAt DateTime @default(now())

  members ScreenerGroupMember[]

  @@index([programId])
}

model ScreenerGroupMember {
  id      String        @id @default(cuid())
  groupId String
  group   ScreenerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  staffId String
  staff   StaffAccount  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([groupId, staffId])
}

// Which program(s) a Program Admin manages. (Paper Screeners are scoped by applicant
// assignment instead — see ApplicantAssignment.)
model StaffProgramAssignment {
  id        String  @id @default(cuid())
  staffId   String
  staff     StaffAccount @relation(fields: [staffId], references: [id], onDelete: Cascade)
  programId Int
  program   Program @relation(fields: [programId], references: [id])

  @@unique([staffId, programId])
}

// Which applicants a Paper Screener has been assigned to review, set by an Admin.
model ApplicantAssignment {
  id          String   @id @default(cuid())
  applicantId Int
  applicant   Applicant    @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  screenerId  String
  screener    StaffAccount @relation(fields: [screenerId], references: [id], onDelete: Cascade)
  assignedAt  DateTime @default(now())

  @@unique([applicantId, screenerId])
  @@index([screenerId])
}

// A Paper Screener's 1-5 score on one soft (human-judged) criterion for one applicant.
model RubricScore {
  id           String   @id @default(cuid())
  applicantId  Int
  applicant    Applicant    @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  screenerId   String
  screener     StaffAccount @relation(fields: [screenerId], references: [id], onDelete: Cascade)
  criterionKey String // "financial_hardship" | "leadership" | "essay_quality"
  score        Int
  updatedAt    DateTime @updatedAt

  @@unique([applicantId, screenerId, criterionKey])
}

// A Paper Screener's overall recommend / not-recommend call on an applicant, with comments.
model Recommendation {
  id          String   @id @default(cuid())
  applicantId Int
  applicant   Applicant    @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  screenerId  String
  screener    StaffAccount @relation(fields: [screenerId], references: [id], onDelete: Cascade)
  decision    String // "recommend" | "not_recommend"
  comment     String   @default("")
  updatedAt   DateTime @updatedAt

  @@unique([applicantId, screenerId])
}

// System/program activity log — user management, red-flag overrides, award decisions.
model AuditLogEntry {
  id        String   @id @default(cuid())
  programId Int? // null = system-wide (not tied to one program)
  program   Program? @relation(fields: [programId], references: [id])
  actor     String // display name of who did it
  action    String
  createdAt DateTime @default(now())

  @@index([programId])
  @@index([createdAt])
}

// Per-program, per-step application field configuration (mockup — governs the "Manage fields" screen).
model FieldConfig {
  id          String  @id @default(cuid())
  programId   Int
  program     Program @relation(fields: [programId], references: [id])
  step        String // "personal" | "family" | "academic" | "leadership" | "community" | "statement"
  label       String
  required    Boolean @default(false)
  enabled     Boolean @default(true)
  order       Int     @default(0)
  fieldType   String  @default("text") // "text" | "paragraph" | "dropdown" | "number" — the applicant-facing input type
  optionsJson String  @default("[]") // dropdown choices, or quick-pick suggestions for the other types: JSON string array

  // Ties this row to a specific Application scalar column (e.g. "fullName", "dob") or to
  // one of the special widget sentinels ("cert" | "video" | "essayText" |
  // "familyMembers") — null means this is an admin-added custom field, whose answers live
  // in Application.customFieldsJson instead of a dedicated column.
  fieldKey String?

  @@index([programId, step])
}

// A check-in survey wave (Mid-Year / Year-End) for a program.
model SurveyWave {
  id        String @id @default(cuid())
  programId Int
  program   Program @relation(fields: [programId], references: [id])
  wave      String // "midYear" | "yearEnd"
  status    String  @default("draft") // "draft" | "deployed"

  questions SurveyQuestion[]

  @@unique([programId, wave])
}

model SurveyQuestion {
  id           String     @id @default(cuid())
  surveyWaveId String
  surveyWave   SurveyWave @relation(fields: [surveyWaveId], references: [id], onDelete: Cascade)
  label        String
  order        Int        @default(0)

  @@index([surveyWaveId])
}

// Records that a survey wave was sent to a given admin-side applicant.
model SurveySend {
  id          Int       @id @default(autoincrement())
  applicantId Int
  applicant   Applicant @relation(fields: [applicantId], references: [id])
  wave        String // "midYear" | "yearEnd"
  sentDate    String

  @@unique([applicantId, wave])
}

// Self-contained, Postgres-backed rate limiting (no external service) — one row per
// attempt against a given key (e.g. "signup:someone@example.com"). checkRateLimit()
// (src/lib/rate-limit.ts) counts recent rows for a key within its window and opportunistically
// prunes that key's rows once they age out, so this table stays bounded without a cron job.
model RateLimitAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
