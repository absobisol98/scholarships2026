# Two Postgres connection strings, both from Supabase: Project Settings > Database >
# Connection string > "URI". This split matters at real traffic volume (each serverless
# function instance opens its own connection pool — the direct connection's limit is small
# and gets exhausted fast under a burst of signups):
#
# DATABASE_URL — what the running app uses for every query. The POOLED connection
# (Session Pooler or Transaction Pooler, port 6543), `?pgbouncer=true` appended.
DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:6543/postgres?pgbouncer=true"
#
# DIRECT_URL — only used by `prisma migrate`/`prisma db push`, never by the app itself.
# The DIRECT connection (port 5432) — migrations need a real, non-pooled connection to
# work reliably (pgbouncer's transaction mode doesn't support prepared statements).
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Signs the demo-login session cookie. Not protecting any real credentials —
# this app's login is a no-password demo — but signing still stops a viewer
# from hand-editing the cookie to grant themselves the admin role.
# Any random string works; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="replace-with-a-random-string"

# "Continue with Google" on the login page. Create an OAuth 2.0 Client ID (type: Web
# application) in the Google Cloud Console under APIs & Services > Credentials.
# - Authorized JavaScript origin: http://localhost:3000 (add your deployed origin too)
# - Authorized redirect URI: http://localhost:3000/api/auth/google/callback
#   (add {your-deployed-origin}/api/auth/google/callback too — must match exactly)
GOOGLE_CLIENT_ID="replace-with-your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-your-google-oauth-client-secret"

# Certificate/video uploads (src/lib/storage.ts) — a Storage bucket in the same Supabase
# project as DATABASE_URL above. Project Settings > API for the URL/service-role key;
# Storage > New bucket (private, not public) for the bucket name.
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-service-role-key"
SUPABASE_STORAGE_BUCKET="application-documents"
