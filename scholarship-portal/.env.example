DATABASE_URL="file:./dev.db"

# Signs the demo-login session cookie. Not protecting any real credentials —
# this app's login is a no-password demo — but signing still stops a viewer
# from hand-editing the cookie to grant themselves the admin role.
# Any random string works; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="replace-with-a-random-string"

# "Continue with Google" on the login page. Create an OAuth 2.0 Client ID (type: Web
# application) in the Google Cloud Console under APIs & Services > Credentials.
# - Authorized JavaScript origin: http://localhost:3000 (add your deployed origin too)
# - Authorized redirect URI: http://localhost:3000/api/auth/google/callback
#   (add {your-deployed-origin}/api/auth/google/callback too — must match exactly)
GOOGLE_CLIENT_ID="replace-with-your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-your-google-oauth-client-secret"
